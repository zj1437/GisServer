<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="org.pygisserver.common.mapper.SystemLogMapper">
     <insert id="saveSystemLog" parameterType="systemLogEntity">
        INSERT INTO system_log(log_id,sys_log_level,sys_log_content,sys_log_src,sys_log_user,sys_log_src_ip,sys_log_time)
        values(DEFAULT,#{logLevel},#{logContent},#{logSrc},#{sysLogUser},#{logSrcIP},#{logHappenedTime})
    </insert>
</mapper>