<!--				</props>-->
<!--			</property>-->
<!--     	</bean>-->
        
        <!-- 加载原geoserver的applictionbean -->
        <import resource="gs-main-bean.xml"/>
        <import resource="gs-wcs-bean.xml"/>
        <import resource="gs-wcs1.0-bean.xml"/>
        <import resource="gs-wcs1.1-bean.xml"/>
        <import resource="gs-wcs2.0-bean.xml"/>
        <import resource="gs-wfs-bean.xml"/>
        <import resource="gs-wms-bean.xml"/>
        <import resource="gs-vectortiles.xml"/>
        <import resource="gs-kml.xml"/>
        <import resource="spring-shiro.xml"/>
</beans>